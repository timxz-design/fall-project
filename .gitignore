node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
expo-env.d.ts

# ---- Native build output ----
**/ios/
**/android/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/
