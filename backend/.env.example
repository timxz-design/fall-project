# Shared bearer token between the bridge service and the backend.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=replace-me-with-a-long-random-string

# Admin HTTP basic auth for /admin/* endpoints.
ADMIN_USER=admin
ADMIN_PASS=change-me

# SQLite database file (relative to backend/).
DATABASE_URL=sqlite:///./fall_detect.db

# Optional: path to Firebase service account JSON.
# If unset, FCM "sends" print to stdout instead of dispatching real notifications.
# FIREBASE_CREDS=./firebase-service-account.json
