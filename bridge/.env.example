# Where RuView's WebSocket lives.
RUVIEW_WS_URL=ws://localhost:3001/ws/sensing

# Where the backend lives.
BACKEND_URL=http://localhost:8000

# Shared bearer token. Must match BRIDGE_TOKEN in backend/.env.
BRIDGE_TOKEN=replace-me-with-a-long-random-string

# Which home this bridge instance is reporting for.
HOME_ID=1

# How often to heartbeat the backend (seconds).
HEARTBEAT_INTERVAL=30

# Rolling window sizes (seconds).
PRE_EVENT_WINDOW_SEC=5
POST_EVENT_WINDOW_SEC=30
